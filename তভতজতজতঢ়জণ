			<!-- INLINE WATCH HISTORY --><script>/**
 * MMSVibe Watch History & Resume Engine
 * Strategy: Client-Side First (localStorage) for Zero Server Load
 */
(function ($) {
    'use strict';

    const STORAGE_KEY = 'mms_watch_history';
    const UPDATE_INTERVAL = 5000; // Update storage every 5 seconds
    const RESUME_THRESHOLD = 10;  // Only resume if > 10s watched
    const END_THRESHOLD = 10;     // and < 10s from end

    class WatchHistory {
        constructor() {
            this.history = this.loadHistory();
            this.init();
        }

        loadHistory() {
            try {
                return JSON.parse(localStorage.getItem(STORAGE_KEY)) || {};
            } catch (e) {
                return {};
            }
        }

        saveHistory() {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(this.history));
        }

        init() {
            this.renderProgressBars(); // Visuals on thumbnails

            // Wait for video player
            $(document).ready(() => {
                this.attachPlayerListeners();
            });
        }

        /**
         * 1. THE WATCHER: Track video progress
         */
        attachPlayerListeners() {
            // Check 1: Direct Video (e.g. mobile or native)
            let $video = $('#wpst-video, video.vjs-tech');

            // Check 2: Iframe Video (Clean Tube Player)
            // This is required because 'player-x.php' wraps the video in a same-origin iframe
            if (!$video.length) {
                const $iframe = $('iframe[src*="player-x.php"]');
                if ($iframe.length) {
                    try {
                        // Same-Origin Iframe access
                        $video = $iframe.contents().find('#wpst-video, video');
                    } catch (e) {
                        // Cross-Origin Access Blocked (should not happen for local player).
                    }
                }
            }

            if (!$video.length) return;

            const post_id = $('article.type-post').data('post-id') || $('body').attr('class').match(/postid-(\d+)/)?.[1];
            if (!post_id) return;

            const vid = $video[0];

            // A. RESUME (The Resumer)
            vid.addEventListener('loadedmetadata', () => {
                const saved = this.history[post_id];
                if (saved && saved.t > RESUME_THRESHOLD && saved.t < (vid.duration - END_THRESHOLD)) {
                    vid.currentTime = saved.t;
                    this.showToast(`Resuming at ${this.formatTime(saved.t)}`);
                }
            });

            // B. TRACK (The Watcher)
            // Throttle updates to avoid hammering localStorage
            let lastUpdate = 0;
            vid.addEventListener('timeupdate', () => {
                const now = Date.now();
                if (now - lastUpdate > UPDATE_INTERVAL) {
                    this.updateProgress(post_id, vid.currentTime, vid.duration);
                    lastUpdate = now;
                }
            });

            // Mark as complete
            vid.addEventListener('ended', () => {
                this.updateProgress(post_id, vid.duration, vid.duration);
            });
        }

        updateProgress(id, time, duration) {
            if (!duration) return;
            const percent = (time / duration) * 100;

            this.history[id] = {
                t: Math.round(time),  // Time (seconds)
                d: Math.round(duration), // Duration
                p: Math.round(percent),  // Percentage
                u: Date.now()         // Last Updated
            };
            this.saveHistory();
        }

        /**
         * 2. THE RENDERER: Paint Red Bars on Thumbnails
         */
        renderProgressBars() {
            $('.thumb-block').each((i, el) => {
                const $el = $(el);
                // Try data-post-id, fallback to id="post-123" extraction
                let pid = $el.data('post-id');
                if (!pid && $el.attr('id')) {
                    const match = $el.attr('id').match(/post-(\d+)/);
                    if (match) pid = match[1];
                }

                if (pid && this.history[pid]) {
                    const data = this.history[pid];
                    // Don't show if < 5% or > 95% (completed)
                    if (data.p > 5 && data.p < 95) {
                        this.injectProgressBar($el, data.p);
                    }
                }
            });
        }

        injectProgressBar($container, percent) {
            // Check if already injected (either bar or badge)
            if ($container.find('.watch-progress-bar').length || $container.find('.watched-badge').length) return;

            const $thumb = $container.find('.post-thumbnail');
            const targetElement = $thumb.length ? $thumb : $container;

            // 1. Red Progress Bar (Bottom) - Only if not nearly complete
            if (percent > 5 && percent < 95) {
                const barHtml = `
                    <div class="watch-progress-bar" style="position: absolute; bottom: 0; left: 0; width: 100%; height: 4px; background: rgba(255,255,255,0.3); z-index: 10;">
                        <div class="fill" style="width: ${percent}%; height: 100%; background: #ff0000;"></div>
                    </div>
                `;
                targetElement.append(barHtml);
            }

            // 2. "WATCHED" Badge (Top Right Overlay) - Only if nearly complete
            if (percent >= 95) {
                const badgeHtml = `
                    <div class="watched-badge" style="position: absolute; top: 10px; right: 10px; background: rgba(0,0,0,0.8); color: #ff0000; font-weight: bold; font-size: 10px; padding: 2px 6px; border-radius: 4px; z-index: 10; border: 1px solid #ff0000;">
                        WATCHED
                    </div>
                `;
                targetElement.append(badgeHtml);
            }
        }

        /**
         * Helper: Toast Message
         */
        showToast(msg) {
            const $toast = $(`<div style="position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); background: rgba(0,0,0,0.8); color: #fff; padding: 8px 16px; border-radius: 4px; font-size: 14px; z-index: 9999; display: none;">${msg}</div>`);
            $('body').append($toast);
            $toast.fadeIn().delay(3000).fadeOut(() => $toast.remove());
        }

        formatTime(seconds) {
            const m = Math.floor(seconds / 60);
            const s = Math.floor(seconds % 60);
            return `${m}:${s < 10 ? '0' : ''}${s}`;
        }
    }

    // Initialize
    new WatchHistory();

})(jQuery);
